.DS_Store
__pycache__/
.vscode/
.openclaw/

# Openclaw workspace files (personal config — templates are in examples/openclaw/)
/AGENTS.md
/SOUL.md
/IDENTITY.md
/USER.md
/TOOLS.md
/HEARTBEAT.md
/CLAUDE.md
/MEMORY.md
front.png

node_modules/
screenshots/*.png
static/*.mp3
static/*.wav

# Recorded dataset sessions (images + logs) — uploaded to Hugging Face via upload_to_hf.py, not committed here
/dataset/

# Policy checkpoints (best.pth is ~415 MB, published as a release asset)
*.pth

# Model weights go in models/, which is committed EMPTY on purpose: clone the
# repo, drop the files in, done. Everything inside it is ignored except the
# marker that keeps the directory in git.
/models/*
!/models/.gitkeep
!/models/README.md

# Per-tick field logs written by --tick-log (jsonl + heatmap thumbnails)
/field_log/

# Pipeline pictures from policy/visualize_pipeline.py
/viz/

# Conda envs normally live under $CONDA_PREFIX/envs, but ignore in-repo ones
# (conda env create -p ./envs/...) and any leftover venvs from the pre-conda setup
/envs/
.venv-sdk/
.venv-policy/

# Speed constants measured per rover from the operator page's calibration panel
policy/calibration.json